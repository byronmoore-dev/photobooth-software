{
  "name": "camera-booth",
  "version": "0.16.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "author": "Camera Booth",
  "description": "Offline-first attendant-operated Electron photo booth",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:bridge": "dotnet publish src/camera-bridge/CameraBridge.csproj -c Release -r win-x64 --self-contained true -o dist-camera-bridge",
    "build": "npm run build:bridge && tsc -p tsconfig.node.json && vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:dead-code": "knip --no-config-hints",
    "format": "prettier --write src tests vite.config.mts vitest.config.mts package.json tsconfig.json tsconfig.node.json README.md postcss.config.cjs index.html",
    "format:check": "prettier --check src tests vite.config.mts vitest.config.mts package.json tsconfig.json tsconfig.node.json README.md postcss.config.cjs index.html",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "ffmpeg-static": "5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "knip": "^6.32.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.camerabooth.attendant",
    "productName": "Camera Booth",
    "asar": true,
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-camera-bridge",
        "to": "camera-bridge"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "licenses/FFmpeg-GPL-3.0.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "licenses/FFmpeg-build-info.txt"
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "Camera-Booth-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "knip": {
    "ignoreDependencies": [
      "tailwindcss"
    ],
    "entry": [
      "src/main/main.ts",
      "src/main/preload.ts"
    ],
    "project": [
      "src/**/*.{ts,tsx}",
      "tests/**/*.ts",
      "*.{ts,mts}"
    ]
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
